# File / 文件：.htaccess
# EN: Project-owned source/configuration file.
# 中文：该文件是本项目自有的源码或配置文件。
# Maintenance / 维护：Preserve validation, safety, and diagnostics when editing. / 修改时保留校验、安全与诊断。
Options -Indexes
RewriteEngine On

# Preserve Bearer Authorization for REST/GraphQL when Apache/FastCGI would
# otherwise strip it before PHP. The raw token is never written to logs by app code.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Never expose source, runtime state, diagnostics, migrations, tests or docs as
# static web files. PHP may still read these paths internally.
RewriteRule ^(?:app|config|database|deploy|docs|integration|scripts|storage|tests)(?:/|$) - [F,L,NC]

# Protect dot-files/secrets and local backup/export artifacts that may be left
# in the project directory during SSH/FileZilla maintenance.
RewriteRule ^\. - [F,L]
RewriteRule \.(?:zip|tar|tgz|gz|sql|dump|log|bak)$ - [F,L,NC]
RewriteRule ^README(?:\.[A-Za-z0-9_-]+)?\.md$ - [F,L,NC]
RewriteRule ^VERSION$ - [F,L,NC]

# Existing public assets/status files are served directly. Everything else is
# dispatched through the application router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
