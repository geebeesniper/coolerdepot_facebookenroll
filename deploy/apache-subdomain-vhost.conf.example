# File / 文件：deploy/apache-subdomain-vhost.conf.example
# EN: Example Apache virtual-host configuration for the Sales Post Tracker subdomain.
# 中文：Sales Post Tracker 子域名的 Apache VirtualHost 配置示例。
# Maintenance / 维护：Replace the example hostname and confirm PHP-FPM routing before production use. / 上线前替换示例域名并确认 PHP-FPM 路由。
# Replace salesposts.YOURDOMAIN.com with the real subdomain.
<VirtualHost *:80>
 ServerName salesposts.YOURDOMAIN.com
 DocumentRoot "/usr/local/apache2/htdocs/sales-posts"
 <Directory "/usr/local/apache2/htdocs/sales-posts">
  Options -Indexes
  AllowOverride All
  Require all granted
  DirectoryIndex index.php
 </Directory>
 <FilesMatch "\.php$">
  SetHandler "proxy:fcgi://php:9000"
 </FilesMatch>
 ErrorLog /proc/self/fd/2
 CustomLog /proc/self/fd/1 combined
</VirtualHost>
